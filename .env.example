# ---- Dashboard access ----
# Secret key required to access the dashboard. Any value, any length.
DASHBOARD_SECRET_KEY=change-me-to-anything-long-and-random

# Signing key for session cookies. If empty, one is derived from DASHBOARD_SECRET_KEY.
SESSION_SIGNING_KEY=

# ---- Server ----
# Dashboard/API on the local network. Keep a strong DASHBOARD_SECRET_KEY.
# go2rtc's internal API/WebRTC/RTSP ports remain loopback-only behind the app proxy.
HOST=0.0.0.0
PORT=3200

# ---- Discovery ----
# Seconds to wait for ONVIF WS-Discovery responses.
DISCOVERY_TIMEOUT=4
# Optional: comma-separated subnets to actively scan as fallback (e.g. 192.168.1.0/24)
DISCOVERY_SCAN_SUBNETS=

# ---- Recording ----
# Root directory for local recordings.
RECORDINGS_DIR=./recordings
# Length of each recorded chunk, in seconds (minimum 60; smaller values are clamped to 60).
SEGMENT_SECONDS=300
# Retention: a sporadic job deletes recordings older than this many days. 0 = keep forever
# (no cleanup); no upper bound — footage grows until the storage monitor pauses at disk-full.
RECORDING_RETENTION_DAYS=7
# Alert when the recordings volume reaches this usage percentage.
STORAGE_ALERT_PERCENT=80
# Stop saving (keep streaming) at this usage %, resume automatically below the next.
STORAGE_FULL_PERCENT=98
STORAGE_RESUME_PERCENT=95
# Size cap (MB) for the HEVC->H.264 playback transcode cache (data/playback_cache/), evicted
# least-recently-used. 0 disables eviction (unbounded). Only derived transcodes — never the
# source recordings.
PLAYBACK_CACHE_MB=2048
# Opt-in: pre-transcode recent HEVC segments in the background so the first Recordings view is
# instant. Costs CPU continuously (unlike the -c:v copy recorder) — enable only with spare CPU.
PLAYBACK_PRETRANSCODE=false

# ---- Live view ----
# Encoder bitrate level for the browser-facing H.264 transcodes: low | medium | high | max.
# Default "max" = the sharpest the stream/camera can give (see backend/app/media/quality.py).
# Lower it if the host is CPU/bandwidth constrained or a level looks over-compressed.
LIVE_QUALITY=max
# Frame rate the transcodes are pinned to. Set to what the camera ACTUALLY delivers (the
# advertised rate lies); these cameras send no PTS so a fixed rate is required. See §34.
LIVE_FPS=10
# How many cameras may share the grid before it drops from the full-resolution main feed to the
# cheap substream. 0 = always substream (safe on a 2-vCPU host). Raising it buys grid sharpness
# with CPU. Per-camera overrides are available live from the dashboard (the Auto/HD/SD toggle).
GRID_HD_MAX_CAMERAS=0
# Hardware transcoder for the H.264 re-encodes. "" = software (libx264, default). Set to a
# go2rtc hardware value to move the encode off the CPU (what makes a sharp grid affordable):
# vaapi (Intel/AMD, needs /dev/dri) | cuda (NVIDIA/NVENC) | v4l2m2m (Raspberry Pi) | rkmpp
# (Rockchip) | dxva2 | videotoolbox (macOS). Device-specific — validate on your box.
LIVE_HWACCEL=

# How often (seconds) the storage monitor re-checks disk usage.
STORAGE_CHECK_SECONDS=30

# ---- Storage backend: local (default) or s3 ----
STORAGE_BACKEND=local

# ---- S3 (only used when STORAGE_BACKEND=s3 or for tiering) ----
S3_BUCKET=
S3_PREFIX=cameras/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Media engine (go2rtc) ---- loopback + 32xx range
GO2RTC_API=http://127.0.0.1:3201
GO2RTC_HOST=127.0.0.1
GO2RTC_RTSP_PORT=3203
GO2RTC_WEBRTC_PORT=3202
GO2RTC_BIN=./bin/go2rtc
# When containerised, point the app at the go2rtc service instead:
#   GO2RTC_API=http://go2rtc:1984  GO2RTC_HOST=go2rtc  GO2RTC_RTSP_PORT=8554  GO2RTC_WEBRTC_PORT=8555

# ---- Advanced (defaults are usually fine) ----
# Auto-start go2rtc + recorder + storage monitor with the API. Set false for an API-only run.
AUTOSTART_SERVICES=true
# Whether this process spawns/owns the go2rtc binary. Set false when go2rtc runs as its own
# container (the compose file sets this) — then the app only generates its config and connects.
MANAGE_GO2RTC=true
# Temporary opt-in for using a phone's Web Bluetooth through a same-origin HTTPS tunnel (for
# example ngrok). Keep false normally and disable the tunnel immediately after onboarding.
PROVISIONING_REMOTE_BLE_ENABLED=false
# SQLite path for the camera registry + recording index (holds encrypted credentials).
DB_PATH=./data/ccg.db
# Directory served as the static dashboard.
FRONTEND_DIR=./frontend
